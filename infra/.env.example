PORT=3000
DATABASE_URL=postgres://postgres:postgres@db:5432/cloud_sentinel
REDIS_URL=redis://redis:6379

# Required. Generate with e.g. `openssl rand -base64 48`. The gateway will
# refuse to start if this isn't set - there is no insecure default anymore.
JWT_SECRET=change-me-to-a-secure-value

# Comma-separated list of origins allowed to call the gateway from a browser,
# e.g. http://localhost:3001,https://your-dashboard.example.com
# Leave blank in production and cross-origin requests are blocked by default;
# leave blank outside production (NODE_ENV != production) and all origins are
# allowed for convenience during local dev.
ALLOWED_ORIGIN=

# Used by docker-compose.yml for both the `db` service and the gateway/worker
# DATABASE_URL. Change this to anything beyond localhost/local dev.
POSTGRES_PASSWORD=postgres

# Only needed if you're running audits against a local AWS-API-compatible mock
# (e.g. LocalStack) instead of real AWS. Leave blank to use real AWS.
# NEVER commit a real host/IP here - this is local-only config, not something
# to check into docker-compose.yml.
FLOCI_ENDPOINT=

# Optional: enables the "Connect AWS Account" flow, letting other users scan
# their OWN AWS accounts via a read-only IAM role they create themselves
# (see infra/cloudformation/cloud-sentinel-scan-role.yaml). Leave both blank
# to keep this deployment scanning only via its own static AWS credentials.
#
# NEXT_PUBLIC_CFN_TEMPLATE_URL: a public HTTPS URL to the CloudFormation
# template above (e.g. a raw.githubusercontent.com link to your fork).
# NEXT_PUBLIC_TRUSTED_PRINCIPAL_ARN: the IAM ARN this worker actually runs
# as in YOUR AWS account - the identity other accounts' roles will trust.
NEXT_PUBLIC_CFN_TEMPLATE_URL=
NEXT_PUBLIC_TRUSTED_PRINCIPAL_ARN=

# AWS Credentials (get from: aws configure export-credentials --format env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

# Gemini API Key (get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=