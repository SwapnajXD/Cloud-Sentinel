# Copy to infra/.env. Never commit the populated file.
# Generate each secret with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=
AWS_REGION=us-east-1
ALLOWED_ORIGIN=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Optional local AWS-compatible emulator (use dummy credentials, not real AWS keys).
FLOCI_ENDPOINT=
MAX_TASK_RETRIES=3
TASK_RETRY_DELAY_SECONDS=5
SCHEDULER_POLL_SECONDS=30
JOB_LEASE_SECONDS=120
# Optional Gemini interpretation. Keys stay on the gateway.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Safe runtime configuration for the guided cross-account setup.
CFN_TEMPLATE_URL=
TRUSTED_PRINCIPAL_ARN=
# AWS credentials are supplied to the worker by .aws.env or an IAM role.
# This app is always single-user; SINGLE_USER_MODE=false is no longer supported.
