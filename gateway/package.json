{
  "name": "cloud-sentinel-gateway",
  "version": "0.1.0",
  "description": "Auth Gateway for Cloud-Sentinel - Node/Express API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:ts": "ts-node server.ts",
    "build": "tsc",
    "dev": "nodemon --exec ts-node server.ts",
    "dev:build": "tsc --watch",
    "pretest": "node -e \"const fs=require('fs');const p='../node_modules';if(!fs.existsSync(p))fs.symlinkSync('gateway/node_modules','../node_modules','dir')\"",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.10.0",
    "redis": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.6.1",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/../tests"],
    "testMatch": [
      "**/*.test.ts"
    ],
    "setupFiles": ["<rootDir>/../tests/jest.setup.ts"],
    "moduleDirectories": ["node_modules"],
    "modulePaths": ["<rootDir>/node_modules"],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
